# FretPilot v2 后端环境变量模板
# 复制为 .env 并填入真实值。切勿把 .env 提交到版本库。

# 调试模式（开发环境 true）
FRETPILOR_DEBUG=true

# 数据库连接串（默认 SQLite）
FRETPILOR_DATABASE_URL=sqlite:///fretpilot.db

# JWT 签名密钥（生产环境务必改成随机长字符串）
FRETPILOR_JWT_SECRET=change-me-to-a-long-random-secret

# BYOK 主密钥（Fernet，用于加密用户自带的 LLM API Key）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FRETPILOR_MASTER_KEY=

# 文件存储根目录（上传的 MIDI / 导出的 GP5）
FRETPILOR_JOB_ROOT=job_root

# 上传文件大小上限（字节）
FRETPILOR_MAX_UPLOAD_BYTES=20971520

# 知识资产目录（留空使用内置 assets）
FRETPILOR_KNOWLEDGE_ASSETS_DIR=

# LLM 请求超时（秒）
FRETPILOR_LLM_REQUEST_TIMEOUT=30.0
