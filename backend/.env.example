# FretPilot v2 后端环境变量模板
# 复制为 .env 并填入真实值。切勿把 .env 提交到版本库。

# 调试模式（开发环境 true）
FRETPILOR_DEBUG=true

# 数据库连接串（默认 SQLite）
FRETPILOR_DATABASE_URL=sqlite:///fretpilot.db

# JWT 签名密钥（生产环境务必改成随机长字符串）
FRETPILOR_JWT_SECRET=change-me-to-a-long-random-secret

# BYOK 主密钥（Fernet，用于加密用户自带的 LLM API Key；生产环境必填）。
# 调试模式留空时会从 JWT 密钥派生可跨重启复用的本地开发密钥。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FRETPILOR_MASTER_KEY=

# 管理员邮箱（逗号分隔）。只有管理员可学习、发布和回滚全局知识库。
FRETPILOR_ADMIN_EMAILS=

# 文件存储根目录（上传的 MIDI / 导出的 GP5）
FRETPILOR_JOB_ROOT=job_root

# 上传文件大小上限（字节）
FRETPILOR_MAX_UPLOAD_BYTES=20971520

# 知识资产目录（留空使用内置 assets）
FRETPILOR_KNOWLEDGE_ASSETS_DIR=

# 可写知识库根目录。首次启动会从内置只读种子初始化。
FRETPILOR_KNOWLEDGE_ROOT=knowledge_store

# 生产前端来源（逗号分隔）
FRETPILOR_CORS_ORIGINS=http://localhost:5173

# LLM 请求超时（秒）
FRETPILOR_LLM_REQUEST_TIMEOUT=30.0
