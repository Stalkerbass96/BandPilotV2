{
  "$schema": "fretpilot.kb4.profile.v2",
  "profile_id": "ample_eclipse",
  "product": "Ample Metal Eclipse",
  "manufacturer": "Ample Sound",
  "kb_version": "1.0.0",
  "manual_source": "Main Panel Manual-AME.pdf (19 pages, 2026-08-16 extracted)",
  "octave_convention": "c3_60",
  "octave_convention_note": "Ample displays C0 for MIDI note 24 (standard C1). All note numbers in this file are raw MIDI note numbers.",

  "global": {
    "playable_min": 36,
    "playable_max": 84,
    "note_channel": 0,
    "keyswitch_velocity": 100,
    "note_off_velocity": 64,
    "keyswitch_length_ticks": 12,
    "legato_overlap_ticks": 30,
    "keyswitch_preroll_ticks": 30
  },

  "articulations": {
    "sustain": {
      "keyswitch": { "note": 24, "label": "C0" },
      "playable_range": { "min": 36, "max": 84 },
      "velocity_layers": [
        { "min": 1,   "max": 21,  "name": "full_mute" },
        { "min": 22,  "max": 42,  "name": "three_quarter_mute" },
        { "min": 43,  "max": 63,  "name": "half_mute" },
        { "min": 64,  "max": 126, "name": "sustain" },
        { "min": 127, "max": 127, "name": "pop_pinch_harmonic" }
      ],
      "persist": true,
      "can_combine_with": "palm_mute"
    },
    "natural_harmonic": {
      "keyswitch": { "note": 25, "label": "C#0" },
      "playable_range": { "min": 40, "max": 69 },
      "velocity_layers": [
        { "min": 1,   "max": 126, "name": "natural_harmonic" },
        { "min": 127, "max": 127, "name": "pinch_harmonic" }
      ],
      "persist": true
    },
    "palm_mute": {
      "keyswitch": { "note": 26, "label": "D0" },
      "playable_range": { "min": 36, "max": 84 },
      "velocity_layers": [
        { "min": 1,   "max": 42,  "name": "full_mute" },
        { "min": 43,  "max": 63,  "name": "three_quarter_mute" },
        { "min": 64,  "max": 127, "name": "half_mute" }
      ],
      "persist": true,
      "can_combine_with": "sustain",
      "note": "Lower velocity = greater mute depth. When C0+D0 both active, high velocity = Sustain, low velocity = Palm Mute."
    },
    "slide_in_out": {
      "keyswitch": { "note": 27, "label": "D#0" },
      "playable_range": { "min": 38, "max": 84 },
      "behaviors": {
        "before_note": "slide_in",
        "during_note": "slide_out"
      },
      "revert_to": "sustain",
      "note": "D#0 before a note triggers Slide In. D#0 during a note triggers Slide Out (velocity determined by D#0). Reverts to Sustain when note ends."
    },
    "legato_slide": {
      "keyswitch": { "note": 28, "label": "E0" },
      "playable_range": { "min": 37, "max": 84 },
      "poly_legato": true,
      "requirements": ["time_overlap", "same_string", "keyswitch_preroll"],
      "velocity_behavior": {
        "high": "change_fret_position",
        "low": "no_fret_change"
      },
      "note": "Press highest note of destination to slide up; lowest to slide down. Slide smoother: long slide (>2 frets) speed determined by destination note velocity."
    },
    "hammer_pull": {
      "keyswitch": { "note": 29, "label": "F0" },
      "playable_range": { "min": 37, "max": 84 },
      "poly_legato": true,
      "requirements": ["time_overlap", "same_string", "keyswitch_preroll"],
      "velocity_behavior": {
        "high": "change_fret_position",
        "low": "no_fret_change"
      },
      "note": "Press highest note of destination for Hammer-On; lowest for Pull-Off. Reverts to previous articulation when destination note ends."
    },
    "tap": {
      "keyswitch": { "note": 30, "label": "F#0" },
      "playable_range": { "min": 37, "max": 84 }
    }
  },

